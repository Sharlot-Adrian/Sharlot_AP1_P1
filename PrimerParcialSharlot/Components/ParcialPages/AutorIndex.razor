@page "/Autor/Index"
@inject ToastService toastService
@inject NavigationManager navigationManager
@inject AutorService autorService
@using Microsoft.AspNetCore.Components.QuickGrid
@using PrimerParcialSharlot.Model
@using PrimerParcialSharlot.Context;

<PageTitle>Index</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-content-center mb-4">
            <h5 class="card-title">Registro de Model1</h5>
            <a href ="/Autor/Create" class="btn btn-primary"><span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">
            @*labels*@
            <div class="row">

                @*filtar*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @*valor filtro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @*inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value=""selected disabled>Elija una opci&oacute;n</option>
                        <option value="Nombres">Nombres</option>
                        <option value="Nacionalidad">Nacionalidad</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>
            @*quickgrid*@

            <div class="container">
                <QuickGrid Items="@itemsQueryable">
                    <PropertyColumn Property="@(a => a.AutorId)" Sortable="true"></PropertyColumn>
                    <PropertyColumn Property="@(a => a.Nombres)" Sortable="true"></PropertyColumn>
                    <PropertyColumn Property="@(a => a.Nacionalidad)" Sortable="true"></PropertyColumn>
                    <PropertyColumn Property="@(a => a.Sueldo)" Sortable="true"></PropertyColumn>

                    <TemplateColumn Title="Opciones">
                        <a href="Autor/Modificar/@context.AutorId" class="btn btn-primary bi-bi-square-pencil">Modificar</a>
                        <a href="" class="btn btn-secondary bi bi-floppy" data-bs-toggle="#modal" data-bs-target ="#eliminacionModal">Eliminar</a>

                    </TemplateColumn>
                    
                </QuickGrid>
            </div>

        </div>
  @*footer*@
  <div class="card-footer justify-content-between align-center">
            <label class="ms-3"><strong>Cantidad: </strong> @itemsQueryable?.Count()</label>
      <label class="ms-3"><strong>Sum: </strong> @itemsQueryable?.Sum(a => a.Sueldo).ToString()</label>
  </div>
    </div>
    </div>

    @*modal eliminacion*@
    <div class="modal" id="eliminacionModal" tabindex="-1" role="dialog" aria-hidden ="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminacion</h5>
                    <button type="button" class="btn-close" aria-valuetext="cerrar"></button>
                </div>

                <div class="modal-body">
                @if(autor != null)
                {
                    <p> desea eliminar este autor?</p>
                }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss ="#modal">Cerrar</button>
                    <button type="button" class="btn btn-primary" data-bs-toggle ="#modal" data-bs-target="#eliminacionModal">Confirmar</button>
                </div>
            </div>
        </div>
    </div>
    

@code {

    IQueryable<Autor> itemsQueryable;
    Autor autor = new Autor();

    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    // protected override Task OnInitializedAsync()
    // {
    //     var items = autorService.FirstOrDefaultAsync(a => a.AutorId > 0);
    //     itemsQueryable = items.AsQueryable();

    // }


    public async Task Buscar()
    {
        if (ValorFiltro.Trim() != "" && Filtro == "Nombres")
        {
            var nombres = itemsQueryable.FirstOrDefault(a => a.AutorId > 0);
           // itemsQueryable = nombres.AsQueryable();
        }

    }

 }


