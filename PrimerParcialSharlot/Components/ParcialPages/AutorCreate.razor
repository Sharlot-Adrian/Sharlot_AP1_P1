@using PrimerParcialSharlot.Model;
@using PrimerParcialSharlot.Service;
@inject ToastService toastService
@inject NavigationManager navigationManager
@inject AutorService autorService
@using Microsoft.AspNetCore.Components.QuickGrid
@using PrimerParcialSharlot.Context;
@using PrimerParcialSharlot.Extentors;

@page "/Autor/Create"

<h3>AutorCreate</h3>

<EditForm Model="autor" OnInvalidSubmit="Guardar">
    <div class="container">
        <div class="card-shadow-lg">
            <div>

                <div class="ms-3">
                    <label class="form-label"><strong>Nombres: </strong></label>
                    <InputText class="form-control" @bind-Value="autor.Nombres"></InputText>
                    <ValidationMessage For="@(() => autor.Nombres)"></ValidationMessage>
                </div>

                <div class="ms-3">
                    <label class="form-label"><strong>Nacionalidad: </strong></label>
                    <InputText class="form-control" @bind-Value="autor.Nacionalidad"></InputText>
                    <ValidationMessage For="@(() => autor.Nacionalidad)"></ValidationMessage>
                </div>

                <div class="ms-3">
                    <label class="form-label"><strong>Sueldo: </strong></label>
                    <InputNumber class="form-control" @bind-Value="autor.Sueldo"></InputNumber>
                    <ValidationMessage For="@(() => autor.Sueldo)"></ValidationMessage>
                </div>

            </div>

            @*footer*@
            <div class = "container mt-2">
                <a href = "/Autor/Index" class = btn btn-primary bi bi-arrow-left>Volver</a>
                <button type = "submit" class = btn btn-seconday bi bi-floppy">Guardar</button>
            </div>
        </div>
    </div>

</EditForm>

@code {

    Autor autor = new Autor();

    public async Task Guardar()
    {
        var guardar = autorService.Guardar(autor);

        if (await guardar)
        {
            toastService.ShowSuccess("Exito al guardar");
            navigationManager.NavigateTo("navigationManager");

        }
        else
        {
             toastService.ShowSuccess("fallo al guardar");
        }
    }  

}
